# Android 16 Beryl recovery fstab
# Derived from stock /vendor/etc/fstab.emmc and vendor ramdisk fstab.mt6855.

# Logical dynamic partitions
/system                         erofs       system       flags=display=system;logical;slotselect;avb=vbmeta_system
/system_ext                     erofs       system_ext   flags=display=system_ext;logical;slotselect;avb=vbmeta_system
/vendor                         erofs       vendor       flags=display=vendor;logical;slotselect;avb=vbmeta
/product                        erofs       product      flags=display=product;logical;slotselect;avb=vbmeta
/vendor_dlkm                    erofs       vendor_dlkm  flags=display=vendor_dlkm;logical;slotselect;avb=vbmeta
/odm_dlkm                       erofs       odm_dlkm     flags=display=odm_dlkm;logical;slotselect;avb=vbmeta
/system_dlkm                    erofs       system_dlkm  flags=display=system_dlkm;logical;slotselect;avb=vbmeta

# Xiaomi extension logical partition
/mnt/vendor/mi_ext              erofs       mi_ext        flags=display=mi_ext;logical;slotselect;avb=vbmeta

# Encryption metadata and userdata.
/metadata                       ext4        /dev/block/by-name/metadata flags=display=metadata
/data                           f2fs        /dev/block/by-name/userdata flags=display=data;fileencryption=aes-256-xts:aes-256-cts:v2;keydirectory=/metadata/vold/metadata_encryption;fsverity;inlinecrypt

# Boot-critical physical partitions.
/boot                           emmc        /dev/block/by-name/boot flags=display=boot;slotselect
/vendor_boot                   emmc        /dev/block/by-name/vendor_boot flags=display=vendor_boot
/init_boot                     emmc        /dev/block/by-name/init_boot flags=display=init_boot
/dtbo                           emmc        /dev/block/by-name/dtbo flags=display=dtbo;slotselect
/vbmeta                         emmc        /dev/block/by-name/vbmeta flags=display=vbmeta;slotselect
/vbmeta_system                  emmc        /dev/block/by-name/vbmeta_system flags=display=vbmeta_system;slotselect
/vbmeta_vendor                  emmc        /dev/block/by-name/vbmeta_vendor flags=display=vbmeta_vendor;slotselect

# Persistent/configuration partitions.
/mnt/vendor/persist             ext4        /dev/block/by-name/persist flags=display=persist
/mnt/vendor/nvdata              ext4        /dev/block/by-name/nvdata flags=display=nvdata
/mnt/vendor/nvcfg               ext4        /dev/block/by-name/nvcfg flags=display=nvcfg

# Stock recovery fstab also exposes these physical partitions.
/cache                          ext4        /dev/block/by-name/rescue flags=display=cache;noauto
/misc                           emmc        /dev/block/by-name/misc flags=display=misc
